{
  "name": "mostra-ai",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:react": "node scripts/prepare-react.mjs",
    "build": "npm run prepare:react && vite build && node scripts/package-react-worker.mjs",
    "dev": "npm run prepare:react && vite",
    "preview": "node scripts/preview-worker.mjs",
    "typecheck": "npm run prepare:react && tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "check:react": "npm run prepare:react && node scripts/check-react-shell.mjs",
    "check:runtime": "npm run prepare:react && node scripts/check-runtime-migration.mjs",
    "check:readiness": "npm run prepare:react && node scripts/check-product-readiness.mjs",
    "check:call-recovery": "node scripts/check-call-recovery.mjs",
    "check:chess": "node scripts/check-chess.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "check": "npm run typecheck && npm run check:ui && npm run check:react && npm run check:runtime && npm run check:readiness && npm run check:call-recovery && npm run check:chess && npm run validate"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "@supabase/supabase-js": "2.95.3",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "14.1.0",
    "lucide-react": "1.55.0",
    "peerjs": "1.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
